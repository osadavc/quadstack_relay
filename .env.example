# Copy to .env. Every value has a working default for `docker compose up`.

# Postgres used by docker compose
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_DB=relay
# Host ports
DB_PORT=5432
WEB_PORT=3000

# Connection string for running the app or seed outside Docker
DATABASE_URL=postgres://relay:relay@localhost:5432/relay

# Signs session cookies. Use a long random string in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Password for the four starting accounts, one per role. Each person can
# change theirs from the account menu.
SEED_PASSWORD=relay2026
